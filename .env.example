# Copy to .env.local for local development against your Supabase project.
# Both values are public by design (the anon key only has the rights RLS grants).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Set to 1 to use the in-browser demo backend instead of Supabase.
VITE_DEMO=0
